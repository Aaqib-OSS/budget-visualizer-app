# Copy to `.env` (git-ignored) and fill in. Vite reads it for both the client
# (import.meta.env) and vite.config.ts (loadEnv), so the two always agree.

# API Gateway stage URL, without the /api/v1 suffix, e.g.
#   https://<api-id>.execute-api.<region>.amazonaws.com/Prod
# Production builds call `${VITE_APIGATEWAY_URL}/api/v1` and allowlist this
# origin in the CSP `connect-src`. Leave empty to call a relative `/api/v1`.
# The dev server proxies /api/v1 here, falling back to a built-in default URL.
VITE_APIGATEWAY_URL=

# Set to 1 to point the dev proxy's /api/v1 at a local resourceQuerier
# (`sam local start-api` on http://127.0.0.1:3000) instead of API Gateway.
# Dev server only; if the local Lambda is down the app falls back to the gateway.
VITE_PROXY_LOCAL_LAMBDA=
